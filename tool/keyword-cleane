<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Keyword Cleaner</title>
<style>
*{box-sizing:border-box}
:root{
  --bg:#f4fbff; --text:#163042; --card-bg:#fff; --card-border:#d9eef8;
  --label:#315265; --input-border:#cfe5ef; --input-bg:#fbfeff;
  --accent:#25b2f1; --accent-dark:#129fdf; --secondary-bg:#eaf8fe; --secondary-text:#168fc7;
  --status:#6b8491; --result-border:#e3f0f5; --item-border:#e8f2f6; --empty:#7b929d;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0f1a20; --text:#e7f3fa; --card-bg:#152530; --card-border:#22394a;
    --label:#a9c3d1; --input-border:#2a4356; --input-bg:#0f1e28;
    --accent:#25b2f1; --accent-dark:#43c0ff; --secondary-bg:#1b3444; --secondary-text:#6fd0ff;
    --status:#8ba7b6; --result-border:#22394a; --item-border:#1e3444; --empty:#7b929d;
  }
}
:root[data-theme="dark"]{
  --bg:#0f1a20; --text:#e7f3fa; --card-bg:#152530; --card-border:#22394a;
  --label:#a9c3d1; --input-border:#2a4356; --input-bg:#0f1e28;
  --accent:#25b2f1; --accent-dark:#43c0ff; --secondary-bg:#1b3444; --secondary-text:#6fd0ff;
  --status:#8ba7b6; --result-border:#22394a; --item-border:#1e3444; --empty:#7b929d;
}
html,body{height:100%}
body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:var(--text);
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.kw-wrap{max-width:900px;margin:30px auto;padding:0 16px}
.kw-card{background:var(--card-bg);border:1px solid var(--card-border);border-radius:20px;box-shadow:0 12px 35px rgba(25,130,175,.10);overflow:hidden}
.kw-head{padding:24px 26px;background:linear-gradient(135deg,#25b2f1,#159bd7);color:#fff}
.kw-head h2{margin:0 0 5px;font-size:23px}
.kw-head p{margin:0;font-size:13px;opacity:.92}
.kw-body{padding:24px}
.kw-label{display:block;font-size:13px;font-weight:700;margin:0 0 8px;color:var(--label)}
.kw-input,.kw-textarea{width:100%;border:1px solid var(--input-border);border-radius:12px;padding:13px 14px;font:inherit;color:var(--text);outline:none;background:var(--input-bg)}
.kw-input:focus,.kw-textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(37,178,241,.12)}
.kw-textarea{min-height:230px;resize:vertical;line-height:1.55}
.kw-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.kw-actions{display:flex;align-items:center;gap:10px;margin-top:18px;flex-wrap:wrap}
.kw-btn{border:0;border-radius:11px;padding:12px 18px;font-weight:700;cursor:pointer;font-size:14px}
.kw-primary{background:var(--accent);color:#fff}.kw-primary:hover{background:var(--accent-dark)}
.kw-secondary{background:var(--secondary-bg);color:var(--secondary-text)}
.kw-status{font-size:13px;color:var(--status);margin-left:auto}
.kw-result{display:none;margin-top:22px;border-top:1px solid var(--result-border);padding-top:20px}
.kw-result.show{display:block}
.kw-result-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:10px;flex-wrap:wrap}
.kw-result-title-group{display:flex;align-items:center;gap:10px}
.kw-result-title{font-weight:800;font-size:15px}
.kw-count{font-size:12px;background:var(--secondary-bg);color:var(--secondary-text);padding:5px 9px;border-radius:20px}
.kw-copy-btn{border:0;border-radius:9px;padding:8px 14px;font-weight:700;cursor:pointer;font-size:13px;background:var(--secondary-bg);color:var(--secondary-text);display:inline-flex;align-items:center;gap:6px}
.kw-copy-btn:hover{background:var(--accent);color:#fff}
.kw-copy-btn.copied{background:#25b27a;color:#fff}
.kw-copy-btn svg{width:14px;height:14px;flex:0 0 auto}
.kw-list{border:1px solid var(--input-border);border-radius:12px;background:var(--input-bg);max-height:360px;overflow:auto;overflow-x:auto}
.kw-item{padding:11px 14px;border-bottom:1px solid var(--item-border);font-size:14px;line-height:1.4}
.kw-item:last-child{border-bottom:0}
.kw-empty{padding:25px;text-align:center;color:var(--empty);font-size:13px}
.kw-credit{margin-top:20px;text-align:center;font-size:12px;color:var(--status)}
.kw-credit a{color:var(--secondary-text);font-weight:700;text-decoration:none}
.kw-credit a:hover{text-decoration:underline}
@media(max-width:720px){.kw-grid{grid-template-columns:1fr}.kw-body{padding:18px}.kw-head{padding:20px}.kw-status{width:100%;margin-left:0}}
</style>
</head>
<body>
<div class="kw-wrap">
  <div class="kw-card">
    <div class="kw-head">
      <h2>Keyword Cleaner</h2>
      <p>Remove the words from your focus keyword and keep the remaining keyword text.</p>
    </div>

    <div class="kw-body">
      <div class="kw-grid">
        <div>
          <label class="kw-label" for="focusKeyword">Focus Keyword</label>
          <input id="focusKeyword" class="kw-input" type="text" placeholder="Paste focus keyword">
        </div>
        <div>
          <label class="kw-label" for="relatedKeywords">Related Keywords</label>
          <textarea id="relatedKeywords" class="kw-textarea" placeholder="Paste your keyword list here, one keyword per line"></textarea>
        </div>
      </div>

      <div class="kw-actions">
        <button class="kw-btn kw-primary" id="cleanBtn">Clean Keywords</button>
        <button class="kw-btn kw-secondary" id="clearBtn">Clear</button>
        <span class="kw-status" id="status">Ready</span>
      </div>

      <div class="kw-result" id="resultBox">
        <div class="kw-result-head">
          <div class="kw-result-title-group">
            <span class="kw-result-title">Results</span>
            <span class="kw-count" id="count">0</span>
          </div>
          <button class="kw-copy-btn" id="copyBtn" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span id="copyBtnLabel">Copy List</span>
          </button>
        </div>
        <div class="kw-list" id="resultList"></div>
      </div>

      <div class="kw-credit">
        Made by <a href="https://contactwithjawad5-alt.github.io/jawad-seo-expert-in-multan/" target="_blank" rel="noopener noreferrer">Jawad SEO Expert</a>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const focus=document.getElementById('focusKeyword');
  const input=document.getElementById('relatedKeywords');
  const resultBox=document.getElementById('resultBox');
  const resultList=document.getElementById('resultList');
  const count=document.getElementById('count');
  const status=document.getElementById('status');
  const copyBtn=document.getElementById('copyBtn');
  const copyBtnLabel=document.getElementById('copyBtnLabel');

  let currentResults=[];

  function esc(s){
    return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
  }

  function cleanKeywords(){
    const words=focus.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    if(!words.length){
      status.textContent='Enter a focus keyword first';
      focus.focus();
      return;
    }

    const pattern=new RegExp('\\b(?:'+words.map(esc).join('|')+')\\b','gi');
    const lines=input.value.split(/\r?\n/);
    const seen=new Set();
    const results=[];

    lines.forEach(line=>{
      const cleaned=line.replace(pattern,'').replace(/\s+/g,' ').trim();
      const key=cleaned.toLowerCase();
      if(cleaned && !seen.has(key)){
        seen.add(key);
        results.push(cleaned);
      }
    });

    currentResults=results;

    resultList.innerHTML='';
    if(!results.length){
      resultList.innerHTML='<div class="kw-empty">No results found.</div>';
    }else{
      results.forEach(keyword=>{
        const row=document.createElement('div');
        row.className='kw-item';
        row.textContent=keyword;
        resultList.appendChild(row);
      });
    }

    count.textContent=results.length+' result'+(results.length===1?'':'s');
    resultBox.classList.add('show');
    status.textContent='Done';
  }

  function fallbackCopy(text){
    const ta=document.createElement('textarea');
    ta.value=text;
    ta.style.position='fixed';
    ta.style.opacity='0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    let ok=false;
    try{ ok=document.execCommand('copy'); }catch(e){ ok=false; }
    document.body.removeChild(ta);
    return ok;
  }

  function copyResults(){
    if(!currentResults.length){
      status.textContent='Nothing to copy yet';
      return;
    }

    const text=currentResults.join('\n');

    function onSuccess(){
      copyBtn.classList.add('copied');
      copyBtnLabel.textContent='Copied!';
      status.textContent='List copied to clipboard';
      setTimeout(()=>{
        copyBtn.classList.remove('copied');
        copyBtnLabel.textContent='Copy List';
      },1800);
    }

    function onFail(){
      status.textContent='Copy failed - please copy manually';
    }

    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(onSuccess).catch(function(){
        fallbackCopy(text) ? onSuccess() : onFail();
      });
    }else{
      fallbackCopy(text) ? onSuccess() : onFail();
    }
  }

  document.getElementById('cleanBtn').addEventListener('click',cleanKeywords);
  copyBtn.addEventListener('click',copyResults);

  document.getElementById('clearBtn').addEventListener('click',function(){
    focus.value='';
    input.value='';
    resultList.innerHTML='';
    resultBox.classList.remove('show');
    count.textContent='0';
    status.textContent='Ready';
    currentResults=[];
    copyBtn.classList.remove('copied');
    copyBtnLabel.textContent='Copy List';
  });
})();
</script>
</body>
</html>
